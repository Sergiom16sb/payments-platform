# Copy this file to .env and adjust values as needed.
# Docker Compose already provides safe defaults for all of these —
# this file is only needed when running the API outside Docker.

PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments

JWT_SECRET=change-me-in-production-min-32-chars-please
JWT_ISSUER=payments-api
JWT_AUDIENCE=payments-client
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

BCRYPT_ROUNDS=10

PAYMENTS_PROCESSOR_URL=http://localhost:8000
PAYMENTS_PROCESSOR_TIMEOUT_MS=5000
PAYMENTS_PROCESSOR_MAX_RETRIES=3

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

PAYMENT_PENDING_REFUND_WINDOW_MINUTES=5